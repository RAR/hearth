<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) replaces the legacy windowBackground splash with the system SplashScreen,
     which shows the launcher icon (no text). We add the wordmark via the branding-image slot — the
     platform's designated place for it — so "Hearth" is present from the first frame, matching the
     baked-in wordmark the Echo (API 30) gets from windowBackground/ic_splash_lockup. -->
<resources>
    <style name="Theme.EchoDash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_wordmark</item>
    </style>
</resources>
